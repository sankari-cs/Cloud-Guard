# Flask
FLASK_SECRET_KEY=replace-with-a-long-random-string
FLASK_ENV=production
# Database (SQLite by default; set DATABASE_URL for Postgres)
# DATABASE_URL=sqlite:////app/instance/cloudguard.db
# DATABASE_URL=postgresql+psycopg://user:pass@db:5432/cloudguard
# Uploads and reports
UPLOAD_FOLDER=/app/uploads
REPORTS_FOLDER=/app/reports
MAX_UPLOAD_SIZE=52428800
# Cookies (set to true only under HTTPS)
SESSION_COOKIE_SECURE=false
