from __future__ import annotations

from collections import Counter
from math import log2
from typing import Protocol


class SecretRule(Protocol):
    name: str
    base_confidence: float


class ContextInfo(Protocol):
    is_env_reference: bool
    is_placeholder: bool
    is_test_value: bool


def shannon_entropy(value: str) -> float:
    """Return the Shannon entropy of a string in bits per character."""
    if not value:
        return 0.0

    length = len(value)
    return -sum(
        (count / length) * log2(count / length)
        for count in Counter(value).values()
    )


def is_high_entropy(value: str) -> bool:
    """Return whether a value has a sufficiently secret-like distribution."""
    return len(value) >= 16 and shannon_entropy(value) >= 3.5


def _score(rule: SecretRule, value: str, ctx: ContextInfo) -> tuple[float, str]:
    confidence = rule.base_confidence
    reasons: list[str] = [f"matched rule '{rule.name}'"]

    ent = shannon_entropy(value)
    if is_high_entropy(value):
        confidence += 0.10
        reasons.append(f"high entropy ({ent:.2f})")
    elif len(value) < 8:
        confidence -= 0.15
        reasons.append("very short value")

    # Strong-format rules (AWS, GitHub, Slack, Stripe, ...) match a known
    # provider format. The format itself is the strongest signal, so we
    # do NOT let "example"/"sample"/"test" markers in the value reduce
    # confidence for these rules — otherwise AWS's documented sample key
    # AKIAIOSFODNN7EXAMPLE would be wrongly suppressed.
    is_specific_format = rule.base_confidence >= 0.85

    if ctx.is_env_reference:
        confidence -= 0.45
        reasons.append("reads from environment")
    if ctx.is_placeholder and not is_specific_format:
        confidence -= 0.40
        reasons.append("placeholder-like value")
    if ctx.is_test_value and not is_specific_format:
        confidence -= 0.20
        reasons.append("test/example value")

    confidence = max(0.0, min(1.0, confidence))
    return confidence, "; ".join(reasons)